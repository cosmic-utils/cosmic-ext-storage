# Rust and the test application share this Bookworm base.  Building the app
# here prevents a host-built binary from requiring a newer glibc at test time.
FROM docker.io/library/rust@sha256:300ec56abce8cc9448ddea2172747d048ed902a3090e6b57babb2bf19f754081

# The concrete package/font versions are reviewed in environment.lock.toml.
# The image never receives the host D-Bus socket, runtime directory, or HOME.
RUN rm -f /etc/apt/sources.list.d/debian.sources \
 && printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20250701T000000Z/ bookworm main' \
      > /etc/apt/sources.list \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      at-spi2-core=2.46.0-5 \
      dbus=1.14.10-1~deb12u1 \
      fonts-dejavu-core=2.37-6 \
      foot=1.13.1-2+deb12u1 \
      grim=1.4.0+ds-2 \
      libbtrfsutil-dev=6.2-1+deb12u1 \
      libclang-dev=1:14.0-55.7~deb12u1 \
      libxkbcommon-dev=1.5.0-1 \
      libvulkan1=1.3.239.0-1 \
      mesa-vulkan-drivers=22.3.6-1+deb12u1 \
      pkg-config=1.8.1-1 \
      sway=1.7-6 \
      wtype=0.4-3 \
 && rm -rf /var/lib/apt/lists/*

# `rust-toolchain.toml` pins this exact compiler.  Install it before copying
# sources so ordinary source edits do not refresh a toolchain layer.
RUN RUSTUP_NO_SELF_UPDATE=1 rustup toolchain install 1.95.0 --profile minimal

COPY . /opt/ui-test/source
WORKDIR /opt/ui-test/source
ARG VERGEN_GIT_SHA
ARG VERGEN_GIT_COMMIT_DATE
ENV VERGEN_GIT_SHA=${VERGEN_GIT_SHA} VERGEN_GIT_COMMIT_DATE=${VERGEN_GIT_COMMIT_DATE}
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/opt/ui-test/target \
    test -n "$VERGEN_GIT_SHA" && test -n "$VERGEN_GIT_COMMIT_DATE" \
 && CARGO_TARGET_DIR=/opt/ui-test/target cargo build --locked --features test-backend --bin cosmic-ext-storage \
 && CARGO_TARGET_DIR=/opt/ui-test/target cargo build --locked -p ui-e2e-runner --bin ui-e2e-runner \
 && install -D -m 0755 /opt/ui-test/target/debug/cosmic-ext-storage /opt/ui-test/bin/cosmic-ext-storage \
 && install -D -m 0755 /opt/ui-test/target/debug/ui-e2e-runner /opt/ui-test/bin/ui-e2e-runner

RUN mkdir -p /opt/ui-test \
 && printf '%s\n' '[theme]' 'name = "light"' > /opt/ui-test/cosmic-theme.toml
